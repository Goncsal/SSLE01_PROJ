# Copy to secrets/platform.env and replace every value.
# Tokens must be at least 16 characters, e.g.:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Postgres: superuser (init only) and one role per service database
POSTGRES_PASSWORD=change-me
PG_PASSWORD_REGISTRY=change-me
PG_PASSWORD_CSMS=change-me
PG_PASSWORD_BILLING=change-me
# registry: NOC token (full scope) and one delegated token per city (writes only pt.<city>.*)
REGISTRY_ADMIN_TOKEN=change-me
REGISTRY_TOKEN_PORTO=change-me
REGISTRY_TOKEN_LISBOA=change-me
REGISTRY_TOKEN_AVEIRO=change-me
# bearer tokens of the other service APIs
CSMS_API_TOKEN=change-me
BILLING_API_TOKEN=change-me
FRAUD_API_TOKEN=change-me
CORRELATOR_API_TOKEN=change-me
# isolate-only tokens used by the Wazuh active responses (quarantine, block, disconnect)
REGISTRY_RESPONDER_TOKEN=change-me
CSMS_RESPONDER_TOKEN=change-me
BILLING_RESPONDER_TOKEN=change-me
# Wazuh agent enrolment password (manager authd.pass)
WAZUH_ENROLL_PASSWORD=change-me
# Grafana admin (monitoring namespace)
GRAFANA_ADMIN_PASSWORD=change-me
WAZUH_API_PASSWORD=change-me
