  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "CSMS replicas up",
      "description": "Replicas answering scrapes out of those known.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"csms\"})",
          "legendFormat": "up",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "count(up{job=\"csms\"})",
          "legendFormat": "total",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
