{
  "uid": "evcharge-platform",
  "title": "EV charging: platform health",
  "description": "CSMS replicas, OCPP latency, dependencies and pod resources.",
  "tags": [
    "evcharge"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
