    {
      "type": "timeseries",
      "title": "Connected chargers per CSMS replica",
      "description": "How the load spreads across replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (evcharge_csms_connected_chargers)",
          "legendFormat": "{{instance}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
