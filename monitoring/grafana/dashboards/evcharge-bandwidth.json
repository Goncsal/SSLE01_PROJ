{
  "uid": "evcharge-bandwidth",
  "title": "EV charging: monitoring bandwidth",
  "description": "What crosses the city to central link with federation, compared with scraping every target directly.",
  "tags": [
    "evcharge"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Federated traffic (bytes per minute)",
      "description": "Uncompressed body of each federation scrape times two scrapes per minute. One line per city.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(scrape_body_size_bytes{job=~\"federate-.+\"}, \"city\", \"$1\", \"job\", \"federate-(.+)\") * 2",
          "legendFormat": "{{city}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Direct scrape traffic (bytes per minute)",
      "description": "Counterfactual: central scraping every city target at 5 s. Empty unless the direct jobs are enabled.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (city) (label_replace(scrape_body_size_bytes{job=~\"direct-.+\"}, \"city\", \"$1\", \"job\", \"direct-(.+)\")) * 12",
          "legendFormat": "{{city}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Federated total (bytes per minute)",
      "description": "Sum over the three cities.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(scrape_body_size_bytes{job=~\"federate-.+\"}) * 2",
          "legendFormat": "federated",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Direct total (bytes per minute)",
      "description": "Sum over the direct jobs, when enabled.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(scrape_body_size_bytes{job=~\"direct-.+\"}) * 12",
          "legendFormat": "direct",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Samples per federation scrape",
      "description": "Series returned by each /federate request.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_samples_scraped{job=~\"federate-.+\"}",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Samples per direct scrape",
      "description": "Samples per scrape of each direct target, summed per job.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (scrape_samples_scraped{job=~\"direct-.+\"})",
          "legendFormat": "{{job}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Head series in the central Prometheus",
      "description": "Active series held in memory; the cost of what is stored centrally.",
      "datasource": {
        "type": "prometheus",
        "uid": "central"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_head_series",
          "legendFormat": "head series",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      }
    }
  ]
}
