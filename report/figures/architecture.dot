digraph arch {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.25, ranksep=0.4, compound=true, newrank=true, pad=0.05, labeljust=l, splines=spline];
  node  [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#444444", margin="0.08,0.04", height=0.3];
  edge  [fontname="Helvetica", fontsize=11, color="#444444", arrowsize=0.6];

  /* attackers (proofs of concept) */
  rogue [label="Rogue device", style="filled,dashed", fillcolor="#f8d0cc", color="#b03a2e"];
  c2    [label="C2 server",    style="filled,dashed", fillcolor="#f8d0cc", color="#b03a2e"];
  mitm  [label="MitM",         style="filled,dashed", fillcolor="#f8d0cc", color="#b03a2e"];

  /* cities */
  subgraph cluster_porto {
    label="Porto (wss + mTLS)"; style="rounded,filled"; fillcolor="#eaf6ea"; color="#4f8f4f";
    pst   [label="5 stations\n(2 chargers each)"];
    pedge [label="Edge\nnginx + city Prometheus"];
  }
  lisboa [label="Lisboa (wss + mTLS)\nedge + 5 stations", fillcolor="#eaf6ea", color="#4f8f4f"];
  aveiro [label="Aveiro (legacy, plain ws)\nedge + 5 stations", fillcolor="#eaf6ea", color="#4f8f4f"];

  /* central platform */
  subgraph cluster_central {
    label="Central: K3s (2 Incus VMs)"; style="rounded,filled"; fillcolor="#eef3fb"; color="#4a6fa5";
    subgraph cluster_mon {
      label="monitoring"; style="rounded,filled"; fillcolor="#ffffff"; color="#8aa4c8";
      cprom [label="Prometheus"];
      am    [label="Alertmanager"];
      graf  [label="Grafana"];
    }
    subgraph cluster_ev {
      label="evcharge"; style="rounded,filled"; fillcolor="#ffffff"; color="#8aa4c8";
      csms     [label="CSMS (2-4 pods)"];
      billing  [label="Billing"];
      fraud    [label="Fraud"];
      registry [label="Registry"];
      pg       [label="PostgreSQL", shape=cylinder, style=filled];
      corr     [label="Correlator", fillcolor="#fff3c4", penwidth=1.6];
    }
    wds [label="Wazuh agents\n(DaemonSet)"];
  }

  /* other Incus instances */
  subgraph cluster_other {
    label="Other Incus instances"; style="rounded,filled"; fillcolor="#f3f3f3"; color="#888888";
    wm [label="Wazuh manager\n+ indexer + dashboard"];
    ca [label="Lab CA"];
    dk [label="Image build VM"];
  }

  /* row ordering */
  {rank=same; rogue; c2; mitm;}
  {rank=same; pedge; lisboa; aveiro;}
  {rank=same; cprom; csms;}
  {rank=same; am; registry; fraud; billing; pg;}
  {rank=same; graf; corr; wm;}
  ca -> dk [style=invis]; wm -> ca [style=invis];
  rogue -> c2 -> mitm [style=invis];
  graf -> wds [style=invis];
  
  /* attacks */
  rogue -> pst    [style=dashed, color="#b03a2e", fontcolor="#b03a2e", label=" stolen cert"];
  c2    -> lisboa [style=dashed, color="#b03a2e", fontcolor="#b03a2e", label=" botnet"];
  mitm  -> aveiro [style=dashed, color="#b03a2e", fontcolor="#b03a2e", label=" rewrite"];

  /* OCPP path */
  pst    -> pedge [penwidth=1.6, color="#1f5fa8"];
  pedge  -> csms  [penwidth=1.6, color="#1f5fa8", lhead=cluster_ev];
  lisboa -> csms  [penwidth=1.6, color="#1f5fa8", lhead=cluster_ev];
  aveiro -> csms  [penwidth=1.6, color="#1f5fa8", lhead=cluster_ev, label=" OCPP", fontcolor="#1f5fa8"];

  /* metrics */
  pedge -> cprom [style=dashed, color="#2e7d32", fontcolor="#2e7d32", label=" federation"];
  cprom -> am; cprom -> graf [style=invis];

  /* platform */
  csms -> registry; csms -> fraud; csms -> billing;
  billing -> pg [arrowhead=none];
  corr -> registry [style=dotted, constraint=false, label="/locate"];

  /* correlator inputs */
  am    -> corr [color="#b8860b", penwidth=1.4];
  fraud -> corr [color="#b8860b", penwidth=1.4];
  corr -> wm [color="#b8860b", penwidth=1.4, dir=back, constraint=false];

  /* Wazuh agents (also on every edge and station) */
  wds -> wm [style=dashed, color="#7b3fa0"];
}
