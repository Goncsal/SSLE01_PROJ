<!--
  EV charging network: fraud (IDs 110200-110299).
  The fraud service decides and acts by itself (block card, quarantine on power_gap) and logs
  fraud.alert, fraud.action and, through the registry and billing, the audit lines: those are
  seen here as 110207/110208 (alert), 110405 (registry quarantine) and 110209 (billing).
  The only Wazuh response in this file is block-card on 110210.
-->
<group name="evcharge,fraud,">

  <rule id="110200" level="4">
    <if_sid>110000</if_sid>
    <field name="event">^auth\.reject$</field>
    <field name="result" type="pcre2">^(Blocked|Invalid|Expired)$</field>
    <description>Authorize refused ($(result)): $(card) at $(hier_id).</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <rule id="110204" level="7">
    <if_sid>110000</if_sid>
    <field name="event">^meter\.anomaly$</field>
    <description>Fraud: meter anomaly ($(reason)) at $(hier_id), card $(card) (T0856 spoof reporting message).</description>
    <mitre><id>T1565.002</id></mitre>
    <group>mitre_ics_T0856,</group>
  </rule>

  <!-- the ALERT for every impossible_travel above FRAUD_MAX_KMH; no active response is attached
       to this id (the block is 110210) -->
  <rule id="110207" level="10">
    <if_sid>110000</if_sid>
    <field name="event">^fraud\.alert$</field>
    <field name="rule">^impossible_travel$</field>
    <description>Fraud service: impossible travel for $(card), $(hier_id) to $(other_hier_id).</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <!-- the block-card trigger: only the alerts the fraud service itself marks as auto-block
       (overlapping sessions, or speed at FRAUD_BLOCK_KMH) AND only when it is not in dry run.
       Both fields must be present: a line without them (older service, other source) never
       blocks, and a dry run keeps matching 110207 only. -->
  <rule id="110210" level="12">
    <if_sid>110207</if_sid>
    <field name="auto_action">^block_card$</field>
    <field name="dry_run">^false$</field>
    <description>Fraud service: high-confidence cloned card $(card) ($(hier_id) to $(other_hier_id)), block.</description>
    <mitre><id>T1078</id></mitre>
    <group>mitre_ics_T0859,</group>
  </rule>

  <rule id="110208" level="9">
    <if_sid>110000</if_sid>
    <field name="event">^fraud\.alert$</field>
    <description>Fraud service alert $(rule) for $(card) at $(hier_id) (T0856).</description>
    <mitre><id>T1565.002</id></mitre>
    <group>mitre_ics_T0856,</group>
  </rule>

  <rule id="110209" level="5">
    <if_sid>110000</if_sid>
    <field name="event" type="pcre2">^billing\.(card_blocked|card_unblocked|session_flagged)$</field>
    <description>Billing audit: $(event) for card $(card).</description>
  </rule>

</group>
