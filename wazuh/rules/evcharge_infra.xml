<!--
  EV charging network: platform health and response audit (IDs 110400-110499), then the
  catch-alls 110090-110092. This file is loaded last, so the catch-alls come after
  every specific sibling.
-->
<group name="evcharge,infra,">

  <rule id="110400" level="8">
    <if_sid>110000</if_sid>
    <field name="event">^dependency\.error$</field>
    <description>Platform: $(service) cannot reach $(dependency) ($(reason)).</description>
  </rule>

  <rule id="110401" level="11" frequency="10" timeframe="120">
    <if_matched_sid>110400</if_matched_sid>
    <global_frequency>yes</global_frequency>
    <same_field>dependency</same_field>
    <description>Platform: dependency $(dependency) failing repeatedly (10 errors in 120 s).</description>
    <mitre><id>T1499</id></mitre>
  </rule>

  <rule id="110405" level="4">
    <if_sid>110000</if_sid>
    <field name="event" type="pcre2">^registry\.(quarantine|release)$</field>
    <description>Response audit: registry $(event) for $(hier_id) (source $(source)).</description>
  </rule>

  <rule id="110406" level="4">
    <if_sid>110000</if_sid>
    <field name="event">^command\.result$</field>
    <field name="source">^wazuh$</field>
    <description>Response audit: command $(command) on $(hier_id) returned $(result).</description>
  </rule>

  <rule id="110410" level="5">
    <if_sid>110000</if_sid>
    <field name="event">^ar\.action$</field>
    <field name="result">^ok$</field>
    <description>Active response $(ar_command) done on $(target) (rule $(rule_id)).</description>
  </rule>

  <rule id="110411" level="10">
    <if_sid>110000</if_sid>
    <field name="event">^ar\.action$</field>
    <field name="result" type="pcre2">^(error|refused)$</field>
    <description>Active response $(ar_command) $(result) on $(target): $(reason).</description>
  </rule>

  <!-- evidence snapshots written by the active responses: kept, not alerted on -->
  <rule id="110412" level="2">
    <if_sid>110000</if_sid>
    <field name="event">^ar\.evidence$</field>
    <description>Active response evidence $(kind) ($(http_status)): $(detail).</description>
  </rule>

  <!--
    Catch-alls. Wazuh tries sibling rules from the highest level down (level 0 first), not
    in file order, so a catch-all of level N would shadow every specific rule of level
    N or less. The events handled by the level 2 rules (110011, 110015, 110412) are
    therefore excluded here.
  -->
  <rule id="110090" level="2">
    <if_sid>110000</if_sid>
    <field name="level" type="pcre2">^(info|debug)$</field>
    <field name="event" type="pcre2">^(?!(session\.start|ar\.evidence)$)</field>
    <description>EV charging network event $(event) from $(service).</description>
  </rule>

  <rule id="110091" level="3">
    <if_sid>110000</if_sid>
    <field name="level">^warning$</field>
    <field name="event" type="pcre2">^(?!(auth\.reject|ar\.evidence)$)</field>
    <description>EV charging network warning $(event) from $(service): $(msg)</description>
  </rule>

  <rule id="110092" level="7">
    <if_sid>110000</if_sid>
    <field name="level" type="pcre2">^(error|critical)$</field>
    <field name="event" type="pcre2">^(?!ar\.evidence$)</field>
    <description>EV charging network error $(event) from $(service): $(msg)</description>
  </rule>

</group>
