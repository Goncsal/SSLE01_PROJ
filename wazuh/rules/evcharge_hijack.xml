<!--
  EV charging network: hijacking (IDs 110100-110199).
  Enterprise ATT&CK IDs in <mitre>; the matching ATT&CK for ICS technique is the
  group mitre_ics_T0xxx and is named in the description.

  110100  duplicate connection for one charger id
  110101  one generic rule for every identity refusal of the CSMS (certificate, serial,
          city, no certificate, edge bypass, forged header, quarantined, unknown or
          malformed id, boot serial); the refusal reason is the event name
  110104  refused because the source address is not the station's (separate: 110132 counts it)
  110132  3 x 110104 from one source within 60 s: stolen credential in use -> evcharge-edge-drop
  110120  edge: client certificate rejected; 110121: 5 of them from one source -> firewall-drop
-->
<group name="evcharge,hijack,">

  <rule id="110100" level="10">
    <if_sid>110000</if_sid>
    <field name="event">^charger\.duplicate_id$</field>
    <description>Hijack: $(hier_id) already connected, second connection from $(srcip) (T0849 masquerading).</description>
    <mitre><id>T1036</id></mitre>
    <group>mitre_ics_T0849,</group>
  </rule>

  <!-- every refusal of the CSMS identity checks except the IP check (110104) -->
  <rule id="110101" level="9">
    <if_sid>110000</if_sid>
    <field name="event" type="pcre2">^(ident\.(cert_mismatch|cert_serial_mismatch|city_mismatch|no_cert|untrusted_peer|spoofed_header|unknown|bad_id|quarantined)|charger\.boot_mismatch)$</field>
    <description>Hijack: identity check refused ($(event)) for $(hier_id) from $(srcip) (T0849 masquerading).</description>
    <mitre><id>T1036</id></mitre>
    <group>mitre_ics_T0849,</group>
  </rule>

  <rule id="110104" level="7">
    <if_sid>110000</if_sid>
    <field name="event">^ident\.ip_mismatch$</field>
    <description>Hijack: $(hier_id) connects from $(srcip), registry expects another address (T0859 valid accounts).</description>
    <mitre><id>T1078</id></mitre>
    <group>mitre_ics_T0859,</group>
  </rule>

  <!-- the two CSMS pods are two agents: global_frequency counts across them.
       Response: evcharge-edge-drop blocks $(srcip) at the edge of its city. -->
  <rule id="110132" level="12" frequency="3" timeframe="60">
    <if_matched_sid>110104</if_matched_sid>
    <global_frequency>yes</global_frequency>
    <same_source_ip />
    <description>Hijack: stolen credential in use from $(srcip) for $(hier_id), 3 refused connections within 60 s (T0859 valid accounts).</description>
    <mitre><id>T1078</id></mitre>
    <group>mitre_ics_T0859,</group>
  </rule>

  <rule id="110120" level="8">
    <if_sid>110000</if_sid>
    <field name="event">^edge\.access$</field>
    <field name="http_status">^400$</field>
    <field name="cert_verify">^FAILED</field>
    <description>Edge: client certificate rejected ($(cert_verify)) from $(srcip) (T0849).</description>
    <mitre><id>T1552.004</id></mitre>
    <group>mitre_ics_T0849,</group>
  </rule>

  <rule id="110121" level="11" frequency="5" timeframe="120">
    <if_matched_sid>110120</if_matched_sid>
    <same_source_ip />
    <description>Edge: 5 rejected client certificates from $(srcip) within 120 s (stolen or revoked credentials).</description>
    <mitre><id>T1552.004</id></mitre>
  </rule>

</group>
