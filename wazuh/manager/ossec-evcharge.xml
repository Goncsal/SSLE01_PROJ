<!-- evcharge begin -->
<!-- Generated block: wazuh/manager/deploy_manager.sh replaces everything between the markers. -->
<ossec_config>

  <global>
@WHITE_LIST@
  </global>

  <!-- the manager reads what its own active responses wrote -->
  <localfile>
    <log_format>json</log_format>
    <location>/var/ossec/logs/evcharge-ar.json</location>
  </localfile>

  <command>
    <name>evcharge-edge-drop</name>
    <executable>evcharge-edge-drop</executable>
    <timeout_allowed>yes</timeout_allowed>
  </command>

  <command>
    <name>quarantine-charger</name>
    <executable>quarantine-charger</executable>
    <timeout_allowed>no</timeout_allowed>
  </command>

  <command>
    <name>block-card</name>
    <executable>block-card</executable>
    <timeout_allowed>no</timeout_allowed>
  </command>

  <!-- certificate bursts and connection floods seen by the edge: drop at the edge that wrote the log -->
  <active-response>
    <command>firewall-drop</command>
    <location>local</location>
    <rules_id>110121,110307</rules_id>
    <timeout>600</timeout>
  </active-response>

  <!-- 110132: address seen by the CSMS (stolen credential in use). Every agent is told, only the
       edge whose city network contains the address acts -->
  <active-response>
    <command>evcharge-edge-drop</command>
    <location>all</location>
    <rules_id>110132</rules_id>
    <timeout>600</timeout>
  </active-response>

  <!-- 110303: a station beacons to an unknown destination; the target is the STATION id, so every
       charger of the station is isolated. No timeout, release is manual -->
  <active-response>
    <command>quarantine-charger</command>
    <location>server</location>
    <rules_id>110303</rules_id>
  </active-response>

  <!-- 110210 honours the fraud service dry-run flag -->
  <active-response>
    <command>block-card</command>
    <location>server</location>
    <rules_id>110210</rules_id>
  </active-response>

  <integration>
    <name>custom-correlator</name>
    <hook_url>http://k3s-master.incus:30804/signals/wazuh</hook_url>
    <group>evcharge</group>
    <level>7</level>
    <alert_format>json</alert_format>
  </integration>

  <!-- response signals (levels 4-5) that set t_mitigated: registry quarantine, active response
       done, billing audit; custom-correlator drops their release/unblock/flag events -->
  <integration>
    <name>custom-correlator</name>
    <hook_url>http://k3s-master.incus:30804/signals/wazuh</hook_url>
    <rule_id>110405,110410,110209</rule_id>
    <alert_format>json</alert_format>
  </integration>

</ossec_config>
<!-- evcharge end -->
